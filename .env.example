# LOCAL DEMO ONLY. These values are public placeholders, not production secrets.
# Copy to .env and replace every secret before using any non-demo environment.
NAMENODE_URLS=http://namenode1:8000,http://namenode2:8000

BLOCK_SIZE=1048576
BLOCK_CHUNK_SIZE=1048576
REPLICATION_FACTOR=3
MIN_REPLICAS_COMMIT=2
MFA_CHALLENGE_TTL_S=300

BLOCK_TOKEN_SECRET=local-demo-block-token-secret-do-not-use
NODE_KEY=local-demo-node-key-do-not-use
JWT_SECRET=local-demo-jwt-secret-do-not-use
ADMIN_USER=demo-admin
ADMIN_PASSWORD=local-demo-password-do-not-use

DATANODE_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
POSTGRES_USER=dfsha
POSTGRES_PASSWORD=local-demo-postgres-password-do-not-use
POSTGRES_DB=dfsha
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=local-demo-replication-password-do-not-use
POSTGRES_PRIMARY_DSN=postgresql://dfsha:local-demo-postgres-password-do-not-use@postgres-primary:5432/dfsha
POSTGRES_REPLICA_DSN=postgresql://dfsha:local-demo-postgres-password-do-not-use@postgres-replica:5432/dfsha

# DataNode 1 example; Compose configures each node's own id and addresses.
NODE_ID=datanode1
INTERNAL_ADDR=datanode1:9001
PUBLIC_ADDR=datanode1:9001

# TLS is not implemented yet; these are placeholders and are deliberately unused.
TLS_CA_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
